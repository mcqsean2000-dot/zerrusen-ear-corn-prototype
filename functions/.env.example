# Copy to a local, untracked .env file only when wiring a real backend.
# Keep real Stripe, Firebase, and service account secrets out of git.

NODE_ENV=development
PORT=8787

# Static storefront URLs used by Stripe-hosted Checkout redirects.
STRIPE_SUCCESS_URL=https://theosfarm.com/?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://theosfarm.com/#delivery
CORS_ALLOWED_ORIGINS=https://theosfarm.com,https://www.theosfarm.com

# Store STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SIGNING_SECRET, and SHIPPO_API_TOKEN
# in Firebase Secret Manager. Never place provider secrets in an environment file.
STRIPE_CURRENCY=usd

# Firestore project identifier only. Do not place service-account JSON in this file.
FIREBASE_PROJECT_ID=theos-farm-ear-corn
FIRESTORE_ORDER_COLLECTION=orderRequests

# Trusted notification configuration. Delivery remains disabled by default.
NOTIFICATION_ADMIN_EMAIL=theosfeedfarm@gmail.com
NOTIFICATION_FROM_EMAIL=replace-with-approved-sender-address
NOTIFICATION_REPLY_TO=theosfeedfarm@gmail.com
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_RECONCILIATION_ENABLED=false
# Store RESEND_API_KEY in Firebase Secret Manager; never place it in a deployed .env file.

# The exported Firebase schedule runs at 8:00 AM Central but queues nothing unless enabled.
DAILY_FULFILLMENT_SUMMARY_ENABLED=false

# Meta publishing remains disabled until both controlled platform tests are approved.
# Store the Page token and Facebook/Instagram IDs in Firebase Secret Manager only.
META_GRAPH_API_VERSION=v26.0
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_RECONCILIATION_ENABLED=false

# Server-side sender address used for Shippo rate calculation.
# Keep the real address in a local .env file, not in git.
SHIP_FROM_NAME=replace-with-ship-from-name
SHIP_FROM_STREET1=replace-with-ship-from-street
SHIP_FROM_STREET2=
SHIP_FROM_CITY=replace-with-ship-from-city
SHIP_FROM_STATE=replace-with-ship-from-state
SHIP_FROM_ZIP=replace-with-ship-from-zip
